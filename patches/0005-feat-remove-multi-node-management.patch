-func getMasterClientCert() (tls.Certificate, error) {
-	masterClientCertMu.RLock()
-	p := masterClientCert
-	masterClientCertMu.RUnlock()
-	if p == nil {
-		return tls.Certificate{}, common.NewError("mtls: master client certificate provider not configured")
-	}
-	return p()
