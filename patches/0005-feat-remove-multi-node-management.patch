-	ambiguous := make(map[string]struct{})
-	for guid, c := range counts {
-		if c > 1 {
-			ambiguous[guid] = struct{}{}
-		}
-	}
-	if selfGuid != "" {
-		if _, ok := counts[selfGuid]; ok {
-			ambiguous[selfGuid] = struct{}{}
-		}
-	}
-	return ambiguous
-}
