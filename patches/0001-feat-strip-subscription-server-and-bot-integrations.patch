-func sanitizeUserAgentForLog(userAgent string) string {
-	clean := strings.Map(func(r rune) rune {
-		if unicode.IsControl(r) {
-			return ' '
-		}
-		return r
-	}, userAgent)
-	runes := []rune(clean)
-	if len(runes) > 512 {
-		return string(runes[:512])
-	}
-	return clean
