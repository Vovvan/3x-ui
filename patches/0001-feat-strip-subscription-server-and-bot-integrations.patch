-func remoteClashKeyAllowed(key string, allowClientConfig bool) bool {
-	switch remoteClashKeyClasses[key] {
-	case remoteClashRouteGraph:
-		return true
-	case remoteClashClientConfig:
-		return allowClientConfig
-	default:
-		return false
-	}
-}
