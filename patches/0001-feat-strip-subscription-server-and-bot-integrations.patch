-		return HappLinkResult{}, s.fail(clientID, reason, started, correlationID, "source unavailable", "", "")
-	}
-	if s.encrypt == nil {
-		return HappLinkResult{}, s.fail(clientID, "service_unavailable", started, correlationID, "encryption unavailable", "", "")
-	}
