-		}, true
-
-	case eventbus.EventOutboundUp:
-		fields := []EmbedField{
-			cleanField(tr("discord.fields.outbound"), e.Source, true),
-		}
-		var data *eventbus.OutboundHealthData
-		switch d := e.Data.(type) {
-		case *eventbus.OutboundHealthData:
-			data = d
-		case eventbus.OutboundHealthData:
-			data = &d
-		}
-		if data != nil && data.Delay > 0 {
