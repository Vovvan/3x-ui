-				proxy["password"] = fmt.Sprintf("%s:%s", serverPassword, client.Password)
-			}
-		}
-	default:
-		return nil
-	}
-
-	if !s.applyTransport(proxy, network, stream) {
-		return nil
-	}
-
-	security, _ := stream["security"].(string)
-	if !s.applySecurity(proxy, security, stream) {
-		return nil
-	}
