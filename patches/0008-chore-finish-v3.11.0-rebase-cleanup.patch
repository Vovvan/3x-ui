-	recentlyDeletedMu.Lock()
-	defer recentlyDeletedMu.Unlock()
-	for _, email := range emails {
-		if email != "" {
-			recentlyDeleted[email] = now
-		}
-	}
-	for e, ts := range recentlyDeleted {
